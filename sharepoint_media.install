<?php

/**
 * @file
 * Install, update and uninstall functions for the SharePoint Media module.
 */

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\media\Entity\MediaType;

/**
 * Implements hook_install().
 */
function sharepoint_media_install() {
  // Create the SharePoint file media type.
  $media_type = MediaType::create([
    'id' => 'sharepoint_file',
    'label' => 'SharePoint File',
    'description' => 'Media type for SharePoint drive items.',
    'source' => 'sharepoint_file',
    'queue_thumbnail_downloads' => FALSE,
    'new_revision' => FALSE,
  ]);
  
  $media_type->save();

  // Create required fields.
  sharepoint_media_create_fields();

  // Set up the media type source field.
  $source_field = $media_type->getSource()->createSourceField($media_type);
  $source_field->getFieldStorageDefinition()->save();
  $source_field->save();

  // Configure the source field.
  $media_type->set('source_configuration', [
    'source_field' => $source_field->getName(),
  ]);
  $media_type->save();

  // Create directories.
  $directories = [
    'public://sharepoint_thumbnails',
    'private://sharepoint_cache',
  ];

  foreach ($directories as $directory) {
    \Drupal::service('file_system')->prepareDirectory($directory, \Drupal\Core\File\FileSystemInterface::CREATE_DIRECTORY | \Drupal\Core\File\FileSystemInterface::MODIFY_PERMISSIONS);
  }

  // Set default configuration.
  $config = \Drupal::configFactory()->getEditable('sharepoint_media.settings');
  $config->setData([
    'auto_sync_enabled' => FALSE,
    'auto_sync_interval' => 3600,
    'auto_refresh_urls' => TRUE,
    'batch_size' => 50,
    'allowed_file_types' => [],
    'max_file_size' => 0,
    'exclude_paths' => '',
    'debug_mode' => FALSE,
    'thumbnail_cache_duration' => 24,
    'url_cache_duration' => 50,
    'concurrent_requests' => 5,
    'enable_search_preprocessing' => TRUE,
    'cache_metadata' => TRUE,
    'lazy_load_thumbnails' => TRUE,
  ]);
  $config->save();

  // Display installation message.
  \Drupal::messenger()->addStatus(t('SharePoint Media module installed successfully. Please configure your Microsoft Graph API connection at <a href="@url">SharePoint Media Settings</a>.', [
    '@url' => \Drupal\Core\Url::fromRoute('sharepoint_media.settings')->toString(),
  ]));
}

/**
 * Implements hook_uninstall().
 */
function sharepoint_media_uninstall() {
  // Delete the media type and all associated media entities.
  $media_storage = \Drupal::entityTypeManager()->getStorage('media');
  $media_type_storage = \Drupal::entityTypeManager()->getStorage('media_type');

  // Delete all SharePoint media entities.
  $query = $media_storage->getQuery()
    ->condition('bundle', 'sharepoint_file')
    ->accessCheck(FALSE);
  $entity_ids = $query->execute();

  if (!empty($entity_ids)) {
    $media_entities = $media_storage->loadMultiple($entity_ids);
    $media_storage->delete($media_entities);
  }

  // Delete the media type.
  $media_type = $media_type_storage->load('sharepoint_file');
  if ($media_type) {
    $media_type->delete();
  }

  // Clean up directories.
  $file_system = \Drupal::service('file_system');
  $directories = [
    'public://sharepoint_thumbnails',
    'private://sharepoint_cache',
  ];

  foreach ($directories as $directory) {
    if (is_dir($directory)) {
      $file_system->deleteRecursive($directory);
    }
  }

  // Clear caches.
  \Drupal::cache()->deleteAll();
  \Drupal::cache('data')->deleteAll();

  // Delete state variables.
  \Drupal::state()->deleteMultiple([
    'sharepoint_media.last_auto_sync',
    'sharepoint_media.sync_status',
  ]);
}

