/**
 * Implements hook_requirements().
 */
function sharepoint_media_requirements($phase) {
  $requirements = [];

  if ($phase === 'runtime') {
    $config = \Drupal::config('sharepoint_media.settings');
    
    // Check if connection is configured.
    $is_configured = $config->get('tenant_id') && $config->get('client_id') && $config->get('client_secret');
    
    $requirements['sharepoint_media_connection'] = [
      'title' => t('SharePoint Media Connection'),
      'value' => $is_configured ? t('Configured') : t('Not configured'),
      'severity' => $is_configured ? REQUIREMENT_OK : REQUIREMENT_WARNING,
      'description' => $is_configured ? 
        t('SharePoint connection is configured.') : 
        t('SharePoint connection is not configured. Please visit the <a href="@url">settings page</a>.', [
          '@url' => \Drupal\Core\Url::fromRoute('sharepoint_media.settings')->toString(),
        ]),
    ];

    // Check Search API configuration.
    $index = \Drupal\search_api\Entity\Index::load('sharepoint_media');
    $search_configured = $index && $index->status();
    
    $requirements['sharepoint_media_search'] = [
      'title' => t('SharePoint Media Search'),
      'value' => $search_configured ? t('Configured') : t('Not configured'),
      'severity' => $search_configured ? REQUIREMENT_OK : REQUIREMENT_INFO,
      'description' => $search_configured ? 
        t('Search index is configured and enabled.') : 
        t('Search index is not configured. Media search functionality will be limited.'),
    ];

    // Check directory permissions.
    $directories = [
      'public://sharepoint_thumbnails',
      'private://sharepoint_cache',
    ];
    
    $directory_issues = [];
    foreach ($directories as $directory) {
      if (!is_dir($directory) || !is_writable($directory)) {
        $directory_issues[] = $directory;
      }
    }
    
    $requirements['sharepoint_media_directories'] = [
      'title' => t('SharePoint Media Directories'),
      'value' => empty($directory_issues) ? t('All directories writable') : t('@count directories not writable', ['@count' => count($directory_issues)]),
      'severity' => empty($directory_issues) ? REQUIREMENT_OK : REQUIREMENT_ERROR,
      'description' => empty($directory_issues) ? 
        t('All required directories are writable.') : 
        t('The following directories are not writable: @directories', ['@directories' => implode(', ', $directory_issues)]),
    ];

    // Check sync status.
    if ($is_configured) {
      $stats = \Drupal::service('sharepoint_media.sync_service')->getSyncStatistics();
      
      $requirements['sharepoint_media_sync'] = [
        'title' => t('SharePoint Media Sync'),
        'value' => t('@count media items', ['@count' => $stats['total_media']]),
        'severity' => REQUIREMENT_INFO,
        'description' => t('Total synchronized media items: @total. Last sync: @last', [
          '@total' => $stats['total_media'],
          '@last' => $stats['last_sync'] ? \Drupal::service('date.formatter')->format($stats['last_sync'], 'medium') : t('Never'),
        ]),
      ];
    }
  }

  return $requirements;
}

/**
 * Update 8001: Add new metadata fields.
 */
function sharepoint_media_update_8001() {
  // Add any new fields that were added after initial release.
  $new_fields = [
    'field_auto_tags' => [
      'type' => 'string_long',
      'label' => 'Auto-generated Tags',
      'required' => FALSE,
      'cardinality' => 1,
    ],
  ];

  foreach ($new_fields as $field_name => $field_config) {
    // Check if field already exists.
    $field_storage = FieldStorageConfig::loadByName('media', $field_name);
    if (!$field_storage) {
      // Create field storage.
      $field_storage = FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'media',
        'type' => $field_config['type'],
        'cardinality' => $field_config['cardinality'],
        'settings' => $field_config['settings'] ?? [],
      ]);
      $field_storage->save();

      // Create field instance.
      $field = FieldConfig::create([
        'field_storage' => $field_storage,
        'bundle' => 'sharepoint_file',
        'label' => $field_config['label'],
        'required' => $field_config['required'],
      ]);
      $field->save();
    }
  }
}